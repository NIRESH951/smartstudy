# Copy to .env.local to override (Vite loads it automatically).

# Development only: where the Vite dev server proxies /api requests.
VITE_BACKEND_URL=http://localhost:8080

# Base path of the REST API as seen by the browser.
# Keep "/api/v1" when the frontend and backend are served from the same site
# (Vite proxy in development, reverse proxy in production). When the API is hosted
# on another domain, set the full URL, e.g. https://api.example.com/api/v1
VITE_API_BASE_URL=/api/v1
