# SmartStudy - environment variables (example values only - never commit real secrets)
#
# The backend reads these from the process environment (IntelliJ run configuration,
# PowerShell session, systemd EnvironmentFile, hosting dashboard ...).
# Spring Boot does NOT read this file automatically - copy the values you need.
# The frontend has its own file: frontend/.env.example

# ---------- profile ----------
# dev (default) for local development, prod for production
SPRING_PROFILES_ACTIVE=dev

# ---------- database (MySQL 8.4) ----------
DB_URL=jdbc:mysql://localhost:3306/smartstudy?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&characterEncoding=UTF-8
DB_USERNAME=smartstudy
# Use the password you chose when creating the MySQL user (database/schema.sql)
DB_PASSWORD=ChangeMe_Str0ng!
DB_POOL_SIZE=10

# ---------- server ----------
SERVER_PORT=8080
# Comma-separated list of browser origins allowed to call the API with cookies
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Session cookie only over HTTPS (true in production)
COOKIE_SECURE=false
SESSION_TIMEOUT=12h

# ---------- features ----------
# Background job: missed-session detection, reminders, readiness snapshots
SCHEDULING_ENABLED=true
# Swagger UI / OpenAPI (always on in dev, off in prod unless true)
API_DOCS_ENABLED=true
